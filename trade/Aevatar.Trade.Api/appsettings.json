{
  "AgentRuntime": {
    "RuntimeType": "Local",
    "Orleans": {
      "ClusterId": "trade-cluster",
      "ServiceId": "trade-service",
      "UseLocalhostClustering": true,
      "SiloPort": 11111,
      "GatewayPort": 30000
    }
  },

  "Trading": {
    "Symbol": "cmt_btcusdt",
    "Interval": "15m",
    "ExecutionMode": "DryRun",
    "MaxPositionPct": 10,
    "MaxTotalPositionPct": 30,
    "MaxLossPerTrade": 2,
    "MaxDailyLoss": 5,
    "MinConfidenceToTrade": 60
  },

  "Analysis": {
    "SentimentWeight": 0.3,
    "TechnicalWeight": 0.4,
    "NewsWeight": 0.3
  },

  "RiskControl": {
    "MaxConsecutiveLosses": 3,
    "CooldownMinutes": 60,
    "StopLossPct": 2,
    "TakeProfitPct": 4
  },
  
  "TradeAudit": {
    "Enabled": true,
    "OutputDir": "trade-audit",
    "IncludeMarketData": false,
    "RequestAiwarsUpload": false
  },
  
  "AiWars": {
    "Enabled": false,
    "BaseUrl": "",
    "ApiKey": "",
    "ApiSecret": "",
    "Passphrase": "",
    "UploadPath": ""
  },
  
  "DecisionEngine": {
    "Mode": "Direct",
    "CognitiveMeshBaseUrl": "",
    "CognitiveMeshStrategy": "Cognitive",
    "CognitiveWorkflow": "maker-v2",
    "TimeoutSeconds": 30
  },

  "Weex": {
    "Mode": "Contract",
    "BaseUrl": "https://api-contract.weex.com",
    "ApiKey": "",
    "ApiSecret": "",
    "Passphrase": ""
  },

  "LLM": {
    "Provider": "OpenAI",
    "Model": "gpt-4",
    "ApiKey": "",
    "Temperature": 0.3,
    "MaxTokens": 2000
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Aevatar.Trade": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
