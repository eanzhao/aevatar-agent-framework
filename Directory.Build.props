<Project>
  <!-- ============================================================
       Aevatar Agent Framework - Global Build Properties
       Applies to all projects in the solution
       ============================================================ -->

  <PropertyGroup>
    <!-- Enable nullable reference types -->
    <Nullable>enable</Nullable>
    
    <!-- Treat warnings as errors in Release builds -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    
    <!-- Enable implicit usings -->
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Enable code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    
    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    
    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    
    <!-- Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Code Analysis Settings -->
  <PropertyGroup>
    <!-- Code metrics thresholds -->
    <!-- CA1502: Cyclomatic complexity threshold (default: 25, we use 15 for stricter check) -->
    <CodeMetricsConfig>
      <CyclomaticComplexityThreshold>15</CyclomaticComplexityThreshold>
      <MaintainabilityIndexThreshold>10</MaintainabilityIndexThreshold>
      <ClassCouplingThreshold>80</ClassCouplingThreshold>
    </CodeMetricsConfig>
  </PropertyGroup>

  <!-- Suppress specific warnings for generated code -->
  <PropertyGroup Condition="'$(MSBuildProjectName.Contains('Generated'))' == 'true' Or '$(MSBuildProjectName)' == 'Grpc.Tools'">
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605</NoWarn>
  </PropertyGroup>

</Project>

