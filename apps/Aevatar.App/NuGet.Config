<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="myget" value="https://www.myget.org/F/aelf-project-dev/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="myget">
      <package pattern="Aevatar*" />
      <package pattern="MineAiFun*" />
      <package pattern="XWorkerAgent*" />
      <package pattern="TelegramWorkerAgent*" />
      <!-- Custom Orleans.Streams.Kafka with Producer configuration support -->
      <package pattern="Orleans.Streams.Kafka" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.Orleans*" />
      <package pattern="Orleans*" />
      <package pattern="Microsoft*" />
      <package pattern="Volo*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>