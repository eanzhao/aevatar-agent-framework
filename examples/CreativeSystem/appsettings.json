{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5099"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Aevatar.Agents": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "System.ClientModel": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "MassTransit": {
    "Stream": {
      "TransportType": "InMemory",
      "TopicPrefix": "creative-events",
      "RuntimeName": "CreativeDemo",
      "TopicMapping": {
        "UoTCoordinatorGAgent": "uot-coordinator"
      }
    }
  }
}

