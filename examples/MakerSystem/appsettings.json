{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.ClientModel": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "MassTransit": {
    "Stream": {
      "TransportType": "InMemory",
      "TopicPrefix": "maker-events",
      "RuntimeName": "MakerDemo",
      "TopicMapping": {
        "MakerCoordinatorGAgent": "maker-coordinator",
        "MakerWorkerGAgent": "maker-worker"
      }
    }
  },
  "LLMProviders": {
    "Default": "deepseek",
    "Providers": {
      "deepseek": {
        "Name": "deepseek",
        "ProviderType": "OpenAI",
        "ApiKey": "",
        "Model": "deepseek-chat",
        "Endpoint": "https://api.deepseek.com"
      }
    }
  }
}
